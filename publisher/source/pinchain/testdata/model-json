{
  "modelspec": "1.0-draft",
  "module": {
    "id": "github.com/openvaultdb/ovdb/publisher/source/model/ecb",
    "name": "ecb",
    "version": "0.1.0"
  },
  "entities": {
    "FxReferenceQuote": {
      "properties": {
        "time": {
          "type": "string",
          "required": true,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "currency": {
          "type": "string",
          "required": true,
          "pattern": "^[A-Z]{3}$"
        },
        "rate": {
          "type": "string",
          "required": true,
          "pattern": "^([0-9]+)([.][0-9]+)?$"
        }
      }
    }
  }
}
